#define ZMK_POINTING_DEFAULT_MOVE_VAL 200  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 7    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <0 0>;
            then-layer = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&tog 1     &to 1  &kp ESC     &mo 4         &kp DOWN  &kp CAPS        &tog 1  &to 2  &kp ENTER  &kp LEFT  &kp RIGHT  &to 1
&kp PG_UP  &mo 2  &bt BT_CLR  &kp UP_ARROW  &trans    &trans
            >;
        };

        layer_1 {
            bindings = <
&mkp LCLK     &mmv MOVE_DOWN  &kp ENTER      &to 2         &kp DOWN_ARROW  &to 0         &mmv MOVE_LEFT  &mmv MOVE_RIGHT  &mkp RCLK  &kp LEFT_ARROW  &kp RIGHT_ARROW  &tog 1
&mmv MOVE_UP  &to 3           &kp BACKSPACE  &kp UP_ARROW  &trans          &trans
            >;
        };

        layer_2 {
            bindings = <
&none         &msc SCRL_DOWN  &sk LCTRL       &tog 2       &kp PAGE_DOWN  &to 0         &msc SCRL_LEFT  &msc SCRL_RIGHT  &mkp LCLK  &kp HOME  &kp END  &to 1
&msc SCRL_UP  &to 3           &sk LEFT_SHIFT  &kp PAGE_UP  &trans         &trans
            >;
        };

        layer_3 {
            bindings = <
&none         &kp B  &kp SPACE      &mo 4         &kp NUMBER_2  &kp LEFT_SHIFT        &kp R  &to 4  &trans  &kp NUMBER_3  &kp NUMBER_4  &none
&kp NUMBER_3  &none  &kp BACKSPACE  &kp NUMBER_1  &trans        &trans
            >;
        };

        layer_4 {
            bindings = <
&none         &kp SLASH  &kp SEMICOLON  &trans  &kp NUMBER_6  &kp LEFT_SHIFT        &kp LEFT_BRACKET  &to 5  &trans  &kp N7  &kp N8  &none
&kp NUMBER_4  &none      &kp SQT        &kp N5  &trans        &trans
            >;
        };

        layer_5 {
            bindings = <
&none         &kp SLASH  &kp SEMICOLON  &trans  &kp NUMBER_6  &kp LEFT_SHIFT        &kp LEFT_BRACKET  &to 6  &trans  &kp N7  &kp N8  &none
&kp NUMBER_5  &none      &kp SQT        &kp N5  &trans        &trans
            >;
        };

        layer_6 {
            bindings = <
&none         &kp SLASH  &kp SEMICOLON  &trans  &kp NUMBER_6  &kp LEFT_SHIFT        &kp LEFT_BRACKET  &to 7  &trans  &kp N7  &kp N8  &none
&kp NUMBER_6  &none      &kp SQT        &kp N5  &trans        &trans
            >;
        };

        layer_7 {
            bindings = <
&none         &kp SLASH  &kp SEMICOLON  &trans  &kp NUMBER_6  &kp LEFT_SHIFT        &kp LEFT_BRACKET  &to 8  &trans  &kp N7  &kp N8  &none
&kp NUMBER_7  &none      &kp SQT        &kp N5  &trans        &trans
            >;
        };

        layer_8 {
            bindings = <
&none         &kp SLASH  &kp SEMICOLON  &trans  &kp NUMBER_6  &kp LEFT_SHIFT        &kp LEFT_BRACKET  &to 9  &trans  &kp N7  &kp N8  &none
&kp NUMBER_8  &none      &kp SQT        &kp N5  &trans        &trans
            >;
        };

        layer_9 {
            bindings = <
&none         &kp SLASH  &kp SEMICOLON  &trans  &kp NUMBER_6  &kp LEFT_SHIFT        &kp LEFT_BRACKET  &to 0  &trans  &kp N7  &kp N8  &none
&kp NUMBER_9  &none      &kp SQT        &kp N5  &trans        &trans
            >;
        };
    };
};
