// #define ZMK_POINTING_DEFAULT_MOVE_VAL 200  
// default: 600
// #define ZMK_POINTING_DEFAULT_SCRL_VAL 7    
// default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <0 0>;
            then-layer = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&sk LCTRL     &kp C_VOL_DN  &to 8  &to 2  &kp Z   &studio_unlock        &kp ESCAPE  &kp CAPS  &kp LEFT_WIN  &kp C  &kp V  &to 1
&kp C_VOL_UP  &to 3         &to 9  &kp A  &trans  &trans
            >;
        };

        layer_1 {
            bindings = <
&kp RET       &mmv MOVE_DOWN  &mkp RCLK  &to 2         &kp DOWN_ARROW  &to 0         &mmv MOVE_LEFT  &mmv MOVE_RIGHT  &mkp LCLK  &kp LEFT_ARROW  &kp RIGHT_ARROW  &none
&mmv MOVE_UP  &to 3           &mkp MB4   &kp UP_ARROW  &trans          &trans
            >;
        };

        layer_2 {
            bindings = <
&kp LEFT_SHIFT  &msc SCRL_DOWN  &sk ESCAPE  &kp LEFT_ALT  &kp PG_DN  &to 0         &msc SCRL_LEFT  &msc SCRL_RIGHT  &kp TAB  &kp HOME  &kp END  &to 1
&msc SCRL_UP    &to 3           &sk DELETE  &kp PG_UP     &trans     &trans
            >;
        };

        layer_3 {
            bindings = <
&kp DELETE    &kp NUMBER_1  &kp NUMBER_9  &to 7         &kp NUMBER_5  &to 0         &kp NUMBER_2  &kp NUMBER_3  &sk LEFT_SHIFT  &kp NUMBER_6  &kp NUMBER_7  &to 4
&kp NUMBER_4  &none         &kp NUMBER_0  &kp NUMBER_8  &trans        &trans
            >;
        };

        layer_4 {
            bindings = <
&kp BACKSPACE  &kp S  &to 5  &to 7  &kp V   &to 0         &kp A  &kp D  &kp SPACE  &kp I  &kp O  &sk LCTRL
&kp W          &to 3  &to 6  &kp U  &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&kp BACKSPACE  &kp N  &kp X  &to 7  &kp Z   &to 0         &kp Q  &kp M  &kp SPACE  &kp J  &kp L  &to 4
&kp P          &to 3  &to 6  &kp K  &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
&kp BACKSPACE  &kp G  &to 5  &to 7  &kp B   &to 0         &kp C  &kp H  &kp SPACE  &kp R  &kp F  &to 4
&kp E          &to 3  &kp Y  &kp T  &trans  &trans
            >;
        };

        layer_7 {
            bindings = <
&kp DELETE            &kp SLASH  &kp COMMA   &kp GRAVE  &kp MINUS  &to 0         &kp SEMICOLON  &kp SQT  &sk LCTRL  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &to 4
&kp NON_US_BACKSLASH  &to 3      &kp PERIOD  &kp EQUAL  &trans     &trans
            >;
        };

        layer_8 {
            bindings = <
&kp F11  &kp F1  &kp F9   &to 2   &kp F5  &to 0         &kp F2  &kp F3  &kp F12  &kp F6  &kp F7  &to 1
&kp F4   &to 3   &kp F10  &kp F6  &trans  &trans
            >;
        };

        layer_9 {
            bindings = <
&none         &bt BT_SEL 1  &none         &bt BT_SEL 2  &none   &to 0         &bt BT_SEL 2  &bt BT_SEL 3  &kp C_POWER  &none  &bt BT_CLR  &to 1
&bt BT_SEL 4  &to 3         &bt BT_SEL 0  &none         &trans  &trans
            >;
        };
    };
};
